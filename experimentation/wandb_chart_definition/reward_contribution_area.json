{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Reward term contributions",
  "data": {"name": "wandb"},
  "transform": [
    {
      "fold": [
        "episode/reward/action_rate",
        "episode/reward/cube_ang_vel",
        "episode/reward/cube_at_goal",
        "episode/reward/cube_dropped",
        "episode/reward/cube_height",
        "episode/reward/cube_lin_vel",
        "episode/reward/cube_on_floor",
        "episode/reward/cube_ori",
        "episode/reward/cube_pos",
        "episode/reward/cube_target_pos",
        "episode/reward/energy",
        "episode/reward/fingertip_pos",
        "episode/reward/hand_table_collision",
        "episode/reward/height",
        "episode/reward/joint_vel",
        "episode/reward/palm_pos",
        "episode/reward/success",
        "episode/reward/termination",
        "episode/reward/wrist_vel"
      ],
      "as": ["term", "value"]
    },
    {"filter": "datum.value != null && datum.value !== 0"}
  ],
  "mark": {"type": "area"},
  "encoding": {
    "x": {"field": "_step", "type": "quantitative", "title": "step"},
    "y": {
      "field": "value",
      "type": "quantitative",
      "stack": "zero",
      "title": "episode reward contribution"
    },
    "color": {"field": "term", "type": "nominal", "title": "term"}
  }
}
