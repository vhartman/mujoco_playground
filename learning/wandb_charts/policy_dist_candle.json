{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "${string:title}",
  "data": {"name": "wandb"},
  "encoding": {
    "x": {"field": "${field:step}", "type": "quantitative", "title": "step"}
  },
  "layer": [
    {
      "mark": {"type": "line", "color": "#1b3d55", "opacity": 0.35, "strokeWidth": 1.75},
      "encoding": {
        "y": {"field": "${field:min}", "type": "quantitative", "title": "value"}
      }
    },
    {
      "mark": {"type": "line", "color": "#1b3d55", "opacity": 0.35, "strokeWidth": 1.75},
      "encoding": {
        "y": {"field": "${field:max}", "type": "quantitative"}
      }
    },
    {
      "mark": {"type": "area", "opacity": 0.85, "color": "#aa2c8b"},
      "encoding": {
        "y": {"field": "${field:p25}", "type": "quantitative"},
        "y2": {"field": "${field:p75}"}
      }
    },
    {
      "mark": {"type": "area", "opacity": 0.35, "color": "#1f77b4"},
      "encoding": {
        "y": {"field": "${field:min}", "type": "quantitative"},
        "y2": {"field": "${field:max}"}
      }
    },
    {
      "mark": {"type": "line", "color": "#1f77b4", "strokeWidth": 1},
      "encoding": {
        "y": {"field": "${field:p50}", "type": "quantitative"}
      }
    },
    {
      "mark": {"type": "line", "color": "#ff7f0e", "strokeWidth": 1, "strokeDash": [4, 3]},
      "encoding": {
        "y": {"field": "${field:mean}", "type": "quantitative"}
      }
    }
  ]
}
