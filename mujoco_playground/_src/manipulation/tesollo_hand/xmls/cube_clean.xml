<frame>
  <body name="cube">
    <freejoint name="cube_freejoint"/>

    <geom name="cube" type="box" size=".03 .03 .03" mass=".108"
          friction=".3 0.05" solimp="0.95 0.99 0.0001" conaffinity="1" condim="3" group="3"/>

    <!-- one thin visual geom per face, different colour per side -->
    <geom type="box" size=".0001 .03 .03" pos=".03 0 0"
          contype="0" conaffinity="0" density="0" group="2" rgba="1 0 0 1"/>
    <geom type="box" size=".0001 .03 .03" pos="-.03 0 0"
          contype="0" conaffinity="0" density="0" group="2" rgba="1 0.5 0 1"/>
    <geom type="box" size=".03 .0001 .03" pos="0 .03 0"
          contype="0" conaffinity="0" density="0" group="2" rgba="1 1 1 1"/>
    <geom type="box" size=".03 .0001 .03" pos="0 -.03 0"
          contype="0" conaffinity="0" density="0" group="2" rgba="1 1 0 1"/>
    <geom type="box" size=".03 .03 .0001" pos="0 0 .03"
          contype="0" conaffinity="0" density="0" group="2" rgba="0 0.4 1 1"/>
    <geom type="box" size=".03 .03 .0001" pos="0 0 -.03"
          contype="0" conaffinity="0" density="0" group="2" rgba="0 0.7 0 1"/>

    <site name="cube_center" pos="0 0 0" group="4"/>
    <site name="cube_red"    pos=".03 0 0"   group="4"/>
    <site name="cube_orange" pos="-.03 0 0"  group="4"/>
    <site name="cube_white"  pos="0 .03 0"   group="4"/>
    <site name="cube_yellow" pos="0 -.03 0"  group="4"/>
    <site name="cube_blue"   pos="0 0 .03"   group="4"/>
    <site name="cube_green"  pos="0 0 -.03"  group="4"/>
  </body>
</frame>
