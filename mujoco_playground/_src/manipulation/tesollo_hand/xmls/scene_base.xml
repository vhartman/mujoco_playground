<mujocoinclude>
  <compiler angle="radian" meshdir="meshes/tesollo"/>

  <option timestep="0.01" integrator="Euler" iterations="5" ls_iterations="8">
    <flag eulerdamp="disable" multiccd="disable" nativeccd="disable"/>
  </option>

  <statistic center="0.118 -0.023 0.063" extent="0.4" meansize="0.01"/>

  <visual>
    <headlight diffuse=".8 .8 .8" ambient=".2 .2 .2" specular="1 1 1"/>
    <rgba force="1 0 0 1"/>
    <global azimuth="120" elevation="-20"/>
    <map force="0.01" stiffness="500"/>
    <scale forcewidth="0.1" contactwidth="0.5" contactheight="0.2"/>
    <quality shadowsize="8192"/>
  </visual>

  <default>
    <joint axis="0 1 0" damping="0.2" armature="0.00149376" actuatorfrcrange="-0.2196 0.2196" frictionloss="0.02"/>
    <default class="visual">
      <geom type="mesh" contype="0" conaffinity="0" group="2"/>
    </default>
    <default class="collision">
      <geom group="3" friction="0.2" solref="0.02 1.5" solimp="0.95 0.99 0.001" type="box" mass="0" material="black"/>
      <default class="palm">
        <geom condim="3" friction="2 0.5 0.001" rgba=".7 .7 .7 .3"/>
      </default>
      <default class="tip">
        <geom margin="0.001" condim="4" friction="1 0.1 0.0002" rgba=".5 .5 .5 .3" solimp="0.99 0.999 0.0001"/>
      </default>
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="1 1 1" width="800" height="800"/>
    <texture name="grid" type="2d" builtin="checker"
          width="512" height="512"
          rgb1="0.29 0.0 0.51"
          rgb2="0.9 0.9 1"/>
    <material name="grid" texture="grid" texrepeat="4 4" reflectance="0.2"/>

    <material name="black" rgba="0.2 0.2 0.2 1"/>
    <material name="white" rgba="0.9 0.9 0.9 1"/>

    <mesh name="rl_dg_mount_c" content_type="model/stl" file="rl_dg_mount_c_simple.STL"/>
    <mesh name="rl_dg_base_c" content_type="model/stl" file="rl_dg_base_c_simple.STL"/>
    <mesh name="rl_dg_palm_c" content_type="model/stl" file="rl_dg_palm_c.STL"/>

    <mesh name="rl_dg_1_1_c" content_type="model/stl" file="rl_dg_1_1_c.STL"/>
    <mesh name="rl_dg_1_2_c" content_type="model/stl" file="rl_dg_1_2_c.STL"/>
    <mesh name="rl_dg_1_3_c" content_type="model/stl" file="rl_dg_1_3_c.STL"/>
    <mesh name="rl_dg_1_4_c" content_type="model/stl" file="rl_dg_1_4_c.STL"/>
    <mesh name="rl_dg_1_tip_c" content_type="model/stl" file="rl_dg_1_tip_c_simple.STL"/>

    <mesh name="rl_dg_2_1_c" content_type="model/stl" file="rl_dg_2_1_c.STL"/>
    <mesh name="rl_dg_2_2_c" content_type="model/stl" file="rl_dg_2_2_c.STL"/>
    <mesh name="rl_dg_2_3_c" content_type="model/stl" file="rl_dg_2_3_c.STL"/>
    <mesh name="rl_dg_2_4_c" content_type="model/stl" file="rl_dg_2_4_c.STL"/>
    <mesh name="rl_dg_2_tip_c" content_type="model/stl" file="rl_dg_2_tip_c_simple.STL"/>

    <mesh name="rl_dg_3_1_c" content_type="model/stl" file="rl_dg_3_1_c.STL"/>
    <mesh name="rl_dg_3_2_c" content_type="model/stl" file="rl_dg_3_2_c.STL"/>
    <mesh name="rl_dg_3_3_c" content_type="model/stl" file="rl_dg_3_3_c.STL"/>
    <mesh name="rl_dg_3_4_c" content_type="model/stl" file="rl_dg_3_4_c.STL"/>
    <mesh name="rl_dg_3_tip_c" content_type="model/stl" file="rl_dg_2_tip_c_simple.STL"/>

    <mesh name="rl_dg_4_1_c" content_type="model/stl" file="rl_dg_4_1_c.STL"/>
    <mesh name="rl_dg_4_2_c" content_type="model/stl" file="rl_dg_4_2_c.STL"/>
    <mesh name="rl_dg_4_3_c" content_type="model/stl" file="rl_dg_4_3_c.STL"/>
    <mesh name="rl_dg_4_4_c" content_type="model/stl" file="rl_dg_4_4_c.STL"/>
    <mesh name="rl_dg_4_tip_c" content_type="model/stl" file="rl_dg_2_tip_c_simple.STL"/>

    <mesh name="rl_dg_5_1_c" content_type="model/stl" file="rl_dg_5_1_c.STL"/>
    <mesh name="rl_dg_5_2_c" content_type="model/stl" file="rl_dg_5_2_c.STL"/>
    <mesh name="rl_dg_5_3_c" content_type="model/stl" file="rl_dg_5_3_c.STL"/>
    <mesh name="rl_dg_5_4_c" content_type="model/stl" file="rl_dg_5_4_c.STL"/>
    <mesh name="rl_dg_5_tip_c" content_type="model/stl" file="rl_dg_2_tip_c_simple.STL"/>
  </asset>

  <worldbody>
    <camera name="side" pos="-0.183 0.396 0.296" xyaxes="-0.783 -0.622 -0.000 0.332 -0.419 0.845"/>
    <geom name="floor" pos="0 0 0" size="0 0 0.01" type="plane" material="grid" contype="1" conaffinity="1"/>
  </worldbody>

  <contact>
    <!-- collisions with mount -->
    <exclude body1="mount" body2="rl_dg_1_1"/>
    <exclude body1="mount" body2="rl_dg_2_1"/>
    <exclude body1="mount" body2="rl_dg_3_1"/>
    <exclude body1="mount" body2="rl_dg_4_1"/>
    <exclude body1="mount" body2="rl_dg_5_1"/>

    <exclude body1="mount" body2="rl_dg_1_2"/>
    <exclude body1="mount" body2="rl_dg_2_2"/>
    <exclude body1="mount" body2="rl_dg_3_2"/>
    <exclude body1="mount" body2="rl_dg_4_2"/>
    <exclude body1="mount" body2="rl_dg_5_2"/>

    <exclude body1="mount" body2="rl_dg_1_3"/>
    <exclude body1="mount" body2="rl_dg_2_3"/>
    <exclude body1="mount" body2="rl_dg_3_3"/>
    <exclude body1="mount" body2="rl_dg_4_3"/>
    <exclude body1="mount" body2="rl_dg_5_3"/>

    <exclude body1="palm_lower" body2="rl_dg_1_1"/>
    <exclude body1="palm_lower" body2="rl_dg_1_2"/>
    <exclude body1="palm_lower" body2="rl_dg_1_3"/>

    <!-- collisions with other fingers -->
    <exclude body1="rl_dg_1_1" body2="rl_dg_2_1"/>
    <exclude body1="rl_dg_1_1" body2="rl_dg_3_1"/>
    <exclude body1="rl_dg_1_1" body2="rl_dg_4_1"/>
    <exclude body1="rl_dg_1_1" body2="rl_dg_5_1"/>

    <exclude body1="rl_dg_1_2" body2="rl_dg_2_1"/>
    <exclude body1="rl_dg_1_2" body2="rl_dg_3_1"/>
    <exclude body1="rl_dg_1_2" body2="rl_dg_4_1"/>
    <exclude body1="rl_dg_1_2" body2="rl_dg_5_1"/>

    <exclude body1="rl_dg_5_1" body2="rl_dg_2_1"/>
    <exclude body1="rl_dg_5_1" body2="rl_dg_3_1"/>
    <exclude body1="rl_dg_5_1" body2="rl_dg_4_1"/>

    <exclude body1="rl_dg_5_2" body2="rl_dg_2_1"/>
    <exclude body1="rl_dg_5_2" body2="rl_dg_3_1"/>
    <exclude body1="rl_dg_5_2" body2="rl_dg_4_1"/>

    <exclude body1="rl_dg_3_1" body2="rl_dg_2_1"/>
    <exclude body1="rl_dg_3_1" body2="rl_dg_4_1"/>
    <exclude body1="rl_dg_4_1" body2="rl_dg_2_1"/>

    <exclude body1="rl_dg_1_1" body2="rl_dg_1_3"/>
    <exclude body1="rl_dg_1_1" body2="rl_dg_1_4"/>
    <exclude body1="rl_dg_1_2" body2="rl_dg_1_4"/>

    <exclude body1="rl_dg_2_1" body2="rl_dg_2_3"/>
    <exclude body1="rl_dg_2_1" body2="rl_dg_2_4"/>
    <exclude body1="rl_dg_2_2" body2="rl_dg_2_4"/>

    <exclude body1="rl_dg_3_1" body2="rl_dg_3_3"/>
    <exclude body1="rl_dg_3_1" body2="rl_dg_3_4"/>
    <exclude body1="rl_dg_3_2" body2="rl_dg_3_4"/>

    <exclude body1="rl_dg_4_1" body2="rl_dg_4_3"/>
    <exclude body1="rl_dg_4_1" body2="rl_dg_4_4"/>
    <exclude body1="rl_dg_4_2" body2="rl_dg_4_4"/>

    <exclude body1="rl_dg_5_1" body2="rl_dg_5_3"/>
    <exclude body1="rl_dg_5_1" body2="rl_dg_5_4"/>
    <exclude body1="rl_dg_5_2" body2="rl_dg_5_4"/>
  </contact>
</mujocoinclude>
