<mujoco model="tesollo_scene">
  <include file="tesollo_wrist_dof.xml"/>
  <include file="reorientation_cube_6cm.xml"/>

  <statistic center="0.118 -0.023 0.063" extent="0.4" meansize="0.01"/>

  <visual>
    <headlight diffuse=".8 .8 .8" ambient=".2 .2 .2" specular="1 1 1"/>
    <rgba force="1 0 0 1"/>
    <global azimuth="120" elevation="-20"/>
    <map force="0.01" stiffness="500"/>
    <scale forcewidth="0.1" contactwidth="0.5" contactheight="0.2"/>
    <quality shadowsize="8192"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="1 1 1" width="800" height="800"/>
    <texture name="grid" type="2d" builtin="checker"
          width="512" height="512"
          rgb1="0.29 0.0 0.51"
          rgb2="0.9 0.9 1"/>
  <material name="grid" texture="grid" texrepeat="4 4" reflectance="0.2"/>
</asset>

  

  <worldbody>
    <camera name="side" pos="-0.183 0.396 0.296" xyaxes="-0.783 -0.622 -0.000 0.332 -0.419 0.845"/>
    <geom name="floor" pos="0 0 0" size="0 0 0.01" type="plane" material="grid" contype="1" conaffinity="1"/>
  </worldbody>

  <sensor>
    <!-- cube. -->
    <framepos name="cube_position" objtype="body" objname="cube"/>
    <framequat name="cube_orientation" objtype="body" objname="cube"/>
    <framelinvel name="cube_linvel" objtype="body" objname="cube"/>
    <frameangvel name="cube_angvel" objtype="body" objname="cube"/>
    <frameangacc name="cube_angacc" objtype="body" objname="cube"/>
    <framezaxis name="cube_upvector" objtype="body" objname="cube"/>

    <contact name="cube_force" geom1="cube" subtree2="rh" num="32" data="force"/>

    <!-- hand. -->
    <framepos name="wrist_position" objtype="site" objname="wrist_site"/>
    <framequat name="wrist_orientation" objtype="site" objname="wrist_site"/>

    <framepos name="palm_position" objtype="site" objname="grasp_site"/>
    <framequat name="palm_orientation" objtype="site" objname="grasp_site"/>
    <framepos name="rl_dg_1_tip_c_position" objtype="site" objname="rl_dg_1_tip_c" reftype="site" refname="grasp_site"/>
    <framepos name="rl_dg_2_tip_c_position" objtype="site" objname="rl_dg_2_tip_c" reftype="site" refname="grasp_site"/>
    <framepos name="rl_dg_3_tip_c_position" objtype="site" objname="rl_dg_3_tip_c" reftype="site" refname="grasp_site"/>
    <framepos name="rl_dg_4_tip_c_position" objtype="site" objname="rl_dg_4_tip_c" reftype="site" refname="grasp_site"/>
    <framepos name="rl_dg_5_tip_c_position" objtype="site" objname="rl_dg_5_tip_c" reftype="site" refname="grasp_site"/>

    <framepos name="rl_dg_1_tip_c_position_global" objtype="site" objname="rl_dg_1_tip_c"/>
    <framepos name="rl_dg_2_tip_c_position_global" objtype="site" objname="rl_dg_2_tip_c"/>
    <framepos name="rl_dg_3_tip_c_position_global" objtype="site" objname="rl_dg_3_tip_c"/>
    <framepos name="rl_dg_4_tip_c_position_global" objtype="site" objname="rl_dg_4_tip_c"/>
    <framepos name="rl_dg_5_tip_c_position_global" objtype="site" objname="rl_dg_5_tip_c"/>
