<mujoco model="tesollo_downwards_rotate_z">
  <include file="scene_base.xml"/>

  <custom>
    <numeric name="contact_sensor_maxmatch" data="105"/>
  </custom>

  <statistic center="0.04 0.04 0.15" extent="0.5" meansize="0.01"/>

  <asset>
    <model name="tesollo_hand" file="tesollo_hand.xml"/>
  </asset>

  <worldbody>
    <body name="hand_mount" pos="-0.05 0 0.28" quat="-1 0 -1 0">
      <include file="tesollo_wrist_joints.xml"/>
      <attach model="tesollo_hand" body="rh" prefix=""/>
    </body>

    <body name="goal" mocap="true" pos="0.15 0.0 0.22">
      <geom type="mesh" mesh="cube_mesh" material="cube" contype="0" conaffinity="0" density="0" group="2"/>
      <geom type="box" size=".035 .035 .035" mass=".108" group="3" contype="0" conaffinity="0"/>
    </body>
  </worldbody>

  <include file="reorientation_cube.xml"/>

  <actuator>
    <position kp="400" kv="100" name="wrist_tx" joint="rj_wrist_0_1" ctrlrange="-0.07 0.07"/>
    <position kp="50"  kv="20"  name="wrist_ty" joint="rj_wrist_0_2" ctrlrange="-0.1 0.1"/>
    <position kp="50"  kv="20"  name="wrist_tz" joint="rj_wrist_0_3" ctrlrange="-0.2 0.1"/>

    <position kp="5"  kv="1" name="wrist_rx" joint="rj_wrist_1_1" ctrlrange="-0.2 0.2"/>
    <position kp="10" kv="1" name="wrist_ry" joint="rj_wrist_1_2" ctrlrange="-0.1 0.3"/>
    <position kp="10" kv="1" name="wrist_rz" joint="rj_wrist_1_3" ctrlrange="-0.2 0.2"/>

    <include file="tesollo_finger_actuators.xml"/>
  </actuator>

  <sensor>
    <!-- cube. -->
    <framepos name="cube_position" objtype="body" objname="cube"/>
    <framequat name="cube_orientation" objtype="body" objname="cube"/>
    <framelinvel name="cube_linvel" objtype="body" objname="cube"/>
    <frameangvel name="cube_angvel" objtype="body" objname="cube"/>
    <frameangacc name="cube_angacc" objtype="body" objname="cube"/>
    <framezaxis name="cube_upvector" objtype="body" objname="cube"/>

    <!-- hand. -->
    <framepos name="palm_position" objtype="site" objname="grasp_site"/>
    <framepos name="rl_dg_1_tip_c_position" objtype="site" objname="rl_dg_1_tip_c"/>
    <framepos name="rl_dg_2_tip_c_position" objtype="site" objname="rl_dg_2_tip_c"/>
    <framepos name="rl_dg_3_tip_c_position" objtype="site" objname="rl_dg_3_tip_c"/>
    <framepos name="rl_dg_4_tip_c_position" objtype="site" objname="rl_dg_4_tip_c"/>
    <framepos name="rl_dg_5_tip_c_position" objtype="site" objname="rl_dg_5_tip_c"/>

    <!-- goal. -->
    <framequat name="cube_goal_orientation" objtype="body" objname="goal"/>
    <framezaxis name="cube_goal_upvector" objtype="body" objname="goal"/>

    <!-- contact forces: full hand vs cube, then per fingertip vs cube. -->
    <contact name="cube_force" geom1="cube" subtree2="rh" num="70" data="force"/>
    <contact name="rl_dg_1_tip_cube_force" geom1="rl_dg_1_tip" geom2="cube" num="4" data="force"/>
    <contact name="rl_dg_2_tip_cube_force" geom1="rl_dg_2_tip" geom2="cube" num="4" data="force"/>
    <contact name="rl_dg_3_tip_cube_force" geom1="rl_dg_3_tip" geom2="cube" num="4" data="force"/>
    <contact name="rl_dg_4_tip_cube_force" geom1="rl_dg_4_tip" geom2="cube" num="4" data="force"/>
    <contact name="rl_dg_5_tip_cube_force" geom1="rl_dg_5_tip" geom2="cube" num="4" data="force"/>

    <!-- net contact force between the cube and the floor (world frame). -->
    <contact name="cube_floor_force" geom1="cube" geom2="floor" num="8" data="force" reduce="netforce"/>
  </sensor>

  <keyframe>
    <key name="home"
      qpos="
      0.067 0 -0.05 0 0.3 0
      0.06 -1.56 0.0 0.0
      -0.1 0.67 0.5 0.5
      0. 0.68 0.62 0.56
      0.1 0.6 0.46 0.6
      0.1 0.47 1.1 0.5

      0.0 0.0 0.035 1 0 0 0"
      ctrl="
      0.03 0 -0.05 0 0.3 0
      0.06 -1.56 0.0 0.0
      -0.1 0.67 0.5 0.5
      0. 0.68 0.62 0.56
      0.1 0.6 0.46 0.6
      0.1 0.47 1.1 0.5"
      mpos="0.15 0.0 0.22"
      mquat="1 0 0 0"/>
  </keyframe>
</mujoco>
