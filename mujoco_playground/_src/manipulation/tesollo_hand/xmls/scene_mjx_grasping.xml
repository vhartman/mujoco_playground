<mujoco model="tesollo_scene">
  <include file="scene_base.xml"/>

  <statistic center="0. 0 0" extent="0.4" meansize="0.01"/>

  <default>
    <default class="cube">
      <geom friction=".3 0.05" conaffinity="2" condim="3"/>
    </default>
  </default>

  <asset>
    <model name="tesollo_hand" file="tesollo_hand.xml"/>
  </asset>

  <worldbody>
    <body name="hand_mount" pos="-0.05 0 0.28" quat="-1 0 -1 0">
      <joint name="rj_wrist_0_1" type="slide" pos="0 0 0" axis="1 0 0" range="-0.5 0.5" actuatorfrcrange="-20 20" damping="20" armature="0.149376" frictionloss="2"/>
      <joint name="rj_wrist_0_2" type="slide" pos="0 0 0" axis="0 1 0" range="-0.5 0.5" actuatorfrcrange="-5. 5." damping="10" armature="0.149376" frictionloss="2"/>
      <joint name="rj_wrist_0_3" type="slide" pos="0 0 0" axis="0 0 1" range="-0.5 0.5" actuatorfrcrange="-5. 5." damping="10" armature="0.149376" frictionloss="2"/>
      <joint name="rj_wrist_1_1" pos="0 0 0" axis="1 0 0" range="-1.6 1.6" actuatorfrcrange="-15 15" damping="2" armature="0.149376" frictionloss="0.2"/>
      <joint name="rj_wrist_1_2" pos="0 0 0" axis="0 1 0" range="-1.6 1.6" actuatorfrcrange="-15 15" damping="3" armature="0.149376" frictionloss="0.2"/>
      <joint name="rj_wrist_1_3" pos="0 0 0" axis="0 0 1" range="-1.6 1.6" actuatorfrcrange="-15 15" damping="2" armature="0.149376" frictionloss="0.2"/>
      <attach model="tesollo_hand" body="rh" prefix=""/>
    </body>
    <body name="goal" mocap="true" pos="0.325 0.17 0.2975">
      <geom type="box" size=".035 .035 .035" mass=".108" group="2" contype="0" conaffinity="0"/>
    </body>
    <body name="cube" pos="0.0 0.0 0.04" quat="1 0 0 0" childclass="cube">
      <freejoint name="cube_freejoint"/>
      <geom name="cube" type="box" size=".035 .035 .035" mass=".0508" group="2"/>
      <site name="cube_center" pos="0 0 0" group="4"/>
    </body>
  </worldbody>

  <sensor>
    <!-- cube. -->
    <framepos name="cube_position" objtype="body" objname="cube"/>
    <framequat name="cube_orientation" objtype="body" objname="cube"/>
    <framelinvel name="cube_linvel" objtype="body" objname="cube"/>
    <frameangvel name="cube_angvel" objtype="body" objname="cube"/>
    <frameangacc name="cube_angacc" objtype="body" objname="cube"/>
    <framezaxis name="cube_upvector" objtype="body" objname="cube"/>

    <!-- hand. -->
    <framepos name="palm_position" objtype="site" objname="grasp_site"/>
    <framepos name="rl_dg_1_tip_c_position" objtype="site" objname="rl_dg_1_tip_c"/>
    <framepos name="rl_dg_2_tip_c_position" objtype="site" objname="rl_dg_2_tip_c"/>
    <framepos name="rl_dg_3_tip_c_position" objtype="site" objname="rl_dg_3_tip_c"/>
    <framepos name="rl_dg_4_tip_c_position" objtype="site" objname="rl_dg_4_tip_c"/>
    <framepos name="rl_dg_5_tip_c_position" objtype="site" objname="rl_dg_5_tip_c"/>

    <!-- goal. -->
    <framequat name="cube_goal_orientation" objtype="body" objname="goal"/>
    <framezaxis name="cube_goal_upvector" objtype="body" objname="goal"/>
  </sensor>

  <actuator>
    <position kp="400" kv="100" name="wrist_tx" joint="rj_wrist_0_1" ctrlrange="-0.5 0.5"/>
    <position kp="50"  kv="20"  name="wrist_ty" joint="rj_wrist_0_2" ctrlrange="-0.5 0.5"/>
    <position kp="50"  kv="20"  name="wrist_tz" joint="rj_wrist_0_3" ctrlrange="-0.5 0.5"/>

    <position kp="5"  kv="1" name="wrist_rx" joint="rj_wrist_1_1" ctrlrange="-1.6 1.6"/>
    <position kp="10" kv="1" name="wrist_ry" joint="rj_wrist_1_2" ctrlrange="-1.6 1.6"/>
    <position kp="10" kv="1" name="wrist_rz" joint="rj_wrist_1_3" ctrlrange="-1.6 1.6"/>

    <include file="tesollo_finger_actuators.xml"/>
  </actuator>

  <keyframe>
    <key name="home"
      qpos="
      0.05 0 -0.05
      0 0.38 0
      0.06 -1.56 0.0 0.0
      -0.1 0.67 0.5 0.5
      0. 0.68 0.62 0.56
      0.1 0.6 0.46 0.6
      0.1 0.47 1.1 0.5

      0.0 0.0 0.05 1 0 0 0"
      ctrl="
      0.05 0 -0.05 0 0.38 0
      0.06 -1.56 0.0 0.0
      -0.1 0.67 0.5 0.5
      0. 0.68 0.62 0.56
      0.1 0.6 0.46 0.6
      0.1 0.47 1.1 0.5" mpos="0.25 0.16 0.25"
      mquat="1 0 0 0"/>
  </keyframe>
</mujoco>
