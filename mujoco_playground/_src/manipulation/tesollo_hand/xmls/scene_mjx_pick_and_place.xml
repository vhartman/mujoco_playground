<mujoco model="tesollo_pick_and_place">
  <compiler angle="radian"/>

  <option timestep="0.01" integrator="Euler" iterations="5" ls_iterations="8">
    <flag eulerdamp="disable" multiccd="disable" nativeccd="disable"/>
  </option>

  <custom>
    <numeric name="contact_sensor_maxmatch" data="105"/>
  </custom>

  <statistic center="0.118 -0.023 0.063" extent="0.4" meansize="0.01"/>

  <visual>
    <headlight diffuse=".8 .8 .8" ambient=".2 .2 .2" specular="1 1 1"/>
    <rgba force="1 0 0 1"/>
    <global azimuth="120" elevation="-20"/>
    <map force="0.01" stiffness="500"/>
    <scale forcewidth="0.1" contactwidth="0.5" contactheight="0.2"/>
    <quality shadowsize="8192"/>
  </visual>

  <default>
    <default class="cube">
      <geom friction=".3 0.05" conaffinity="2" condim="3"/>
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="1 1 1" width="800" height="800"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="1 1 1" rgb2="1 1 1" markrgb="0 0 0"
      width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0"/>
    <material name="table" rgba="0.82 0.71 0.55 1"/>
    <model name="tesollo_trans3" file="tesollo_trans3_rot3_standalone.xml"/>
  </asset>

  <worldbody>
    <camera name="side" pos="-0.183 0.396 0.296" xyaxes="-0.783 -0.622 -0.000 0.332 -0.419 0.845"/>
    <geom name="floor" pos="0 0 0" size="0 0 0.01" type="plane" material="groundplane" contype="1" conaffinity="1"/>

    <body pos="-0.05 0 0.28" quat="-1 0 -1 0">
      <attach model="tesollo_trans3" body="rh" prefix=""/>
    </body>

    <body name="table" pos="0.32 0.15 0.0375">
      <geom name="table_top" type="box" size="0.0925 0.0925 0.0375" material="table" contype="1" conaffinity="1"/>
    </body>

    <body name="goal" mocap="true" pos="0.325 0.17 0.11">
      <geom type="box" size=".035 .035 .035" mass=".108" group="2" contype="0" conaffinity="0"/>
    </body>

    <body name="cube" pos="0.0 0.0 0.035" quat="1 0 0 0" childclass="cube">
      <freejoint name="cube_freejoint"/>
      <geom name="cube" type="box" size=".035 .035 .035" mass=".0508" group="2"/>
      <site name="cube_center" pos="0 0 0" group="4"/>
    </body>
  </worldbody>

  <actuator>
    <position kp="400" kv="100" name="rj_wrist_0_1_a" joint="rj_wrist_0_1" ctrlrange="-0.5 0.5"/>
    <position kp="50"  kv="20"  name="rj_wrist_0_2_a" joint="rj_wrist_0_2" ctrlrange="-0.5 0.5"/>
    <position kp="50"  kv="20"  name="rj_wrist_0_3_a" joint="rj_wrist_0_3" ctrlrange="-0.5 0.5"/>

    <position kp="5"  kv="1" name="rj_wrist_1_1_a" joint="rj_wrist_1_1" ctrlrange="-1.6 1.6"/>
    <position kp="10" kv="1" name="rj_wrist_1_2_a" joint="rj_wrist_1_2" ctrlrange="-1.6 1.6"/>
    <position kp="10" kv="1" name="rj_wrist_1_3_a" joint="rj_wrist_1_3" ctrlrange="-1.6 1.6"/>

    <position kp="3" name="rj_dg_1_1_a" joint="rj_dg_1_1" ctrlrange="-0.383972 0.890118"/>
    <position kp="3" name="rj_dg_1_2_a" joint="rj_dg_1_2" ctrlrange="-3.14159 0"/>
    <position kp="3" name="rj_dg_1_3_a" joint="rj_dg_1_3" ctrlrange="0 1.5708"/>
    <position kp="3" name="rj_dg_1_4_a" joint="rj_dg_1_4" ctrlrange="0 1.5708"/>

    <position kp="3" name="rj_dg_2_1_a" joint="rj_dg_2_1" ctrlrange="-0.418879 0.610865"/>
    <position kp="3" name="rj_dg_2_2_a" joint="rj_dg_2_2" ctrlrange="0 2.00713"/>
    <position kp="3" name="rj_dg_2_3_a" joint="rj_dg_2_3" ctrlrange="0 1.5708"/>
    <position kp="3" name="rj_dg_2_4_a" joint="rj_dg_2_4" ctrlrange="0 1.5708"/>

    <position kp="3" name="rj_dg_3_1_a" joint="rj_dg_3_1" ctrlrange="-0.610865 0.610865"/>
    <position kp="3" name="rj_dg_3_2_a" joint="rj_dg_3_2" ctrlrange="0 1.95477"/>
    <position kp="3" name="rj_dg_3_3_a" joint="rj_dg_3_3" ctrlrange="0 1.5708"/>
    <position kp="3" name="rj_dg_3_4_a" joint="rj_dg_3_4" ctrlrange="0 1.5708"/>

    <position kp="3" name="rj_dg_4_1_a" joint="rj_dg_4_1" ctrlrange="-0.610865 0.418879"/>
    <position kp="3" name="rj_dg_4_2_a" joint="rj_dg_4_2" ctrlrange="0 1.90241"/>
    <position kp="3" name="rj_dg_4_3_a" joint="rj_dg_4_3" ctrlrange="0 1.5708"/>
    <position kp="3" name="rj_dg_4_4_a" joint="rj_dg_4_4" ctrlrange="0 1.5708"/>

    <position kp="3" name="rj_dg_5_1_a" joint="rj_dg_5_1" ctrlrange="-0.0174533 1.0472"/>
    <position kp="3" name="rj_dg_5_2_a" joint="rj_dg_5_2" ctrlrange="-0.418879 0.610865"/>
    <position kp="3" name="rj_dg_5_3_a" joint="rj_dg_5_3" ctrlrange="0 1.5708"/>
    <position kp="3" name="rj_dg_5_4_a" joint="rj_dg_5_4" ctrlrange="0 1.5708"/>
  </actuator>

  <sensor>
    <!-- cube. -->
    <framepos name="cube_position" objtype="body" objname="cube"/>
    <framequat name="cube_orientation" objtype="body" objname="cube"/>
    <framelinvel name="cube_linvel" objtype="body" objname="cube"/>
    <frameangvel name="cube_angvel" objtype="body" objname="cube"/>
    <frameangacc name="cube_angacc" objtype="body" objname="cube"/>
    <framezaxis name="cube_upvector" objtype="body" objname="cube"/>

    <!-- hand. -->
    <framepos name="palm_position" objtype="site" objname="grasp_site"/>
    <framepos name="rl_dg_1_tip_c_position" objtype="site" objname="rl_dg_1_tip_c"/>
    <framepos name="rl_dg_2_tip_c_position" objtype="site" objname="rl_dg_2_tip_c"/>
    <framepos name="rl_dg_3_tip_c_position" objtype="site" objname="rl_dg_3_tip_c"/>
    <framepos name="rl_dg_4_tip_c_position" objtype="site" objname="rl_dg_4_tip_c"/>
    <framepos name="rl_dg_5_tip_c_position" objtype="site" objname="rl_dg_5_tip_c"/>

    <!-- goal. -->
    <framequat name="cube_goal_orientation" objtype="body" objname="goal"/>
    <framezaxis name="cube_goal_upvector" objtype="body" objname="goal"/>

    <!-- contact forces: full hand vs cube, then per fingertip vs cube. -->
    <contact name="cube_force" geom1="cube" subtree2="rh" num="70" data="force"/>
    <contact name="rl_dg_1_tip_cube_force" geom1="rl_dg_1_tip" geom2="cube" num="4" data="force"/>
    <contact name="rl_dg_2_tip_cube_force" geom1="rl_dg_2_tip" geom2="cube" num="4" data="force"/>
    <contact name="rl_dg_3_tip_cube_force" geom1="rl_dg_3_tip" geom2="cube" num="4" data="force"/>
    <contact name="rl_dg_4_tip_cube_force" geom1="rl_dg_4_tip" geom2="cube" num="4" data="force"/>
    <contact name="rl_dg_5_tip_cube_force" geom1="rl_dg_5_tip" geom2="cube" num="4" data="force"/>
  </sensor>

  <keyframe>
    <key name="home"
      qpos="
      0.02 0 -0.05 0 0.38 0
      0.06 -1.56 0.0 0.0
      -0.1 0.67 0.5 0.5
      0. 0.68 0.62 0.56
      0.1 0.6 0.46 0.6
      0.1 0.47 1.1 0.5
      0.0 0.0 0.035 1 0 0 0"
      ctrl="
      0.02 0 -0.05 0 0.38 0
      0.06 -1.56 0.0 0.0
      -0.1 0.67 0.5 0.5
      0. 0.68 0.62 0.56
      0.1 0.6 0.46 0.6
      0.1 0.47 1.1 0.5"
      mpos="0.325 0.17 0.11"
      mquat="1 0 0 0"/>
  </keyframe>
</mujoco>
